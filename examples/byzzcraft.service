# systemd unit for the ByzzCraft panel (not the Minecraft server: the panel starts that on demand).
# Install:  sudo cp byzzcraft.service /etc/systemd/system/  &&  sudo systemctl enable --now byzzcraft
# Edit User and the paths first. Run it as the same user that owns the server files, never as root.
[Unit]
Description=ByzzCraft Minecraft panel
After=network-online.target
Wants=network-online.target

[Service]
User=minecraft
WorkingDirectory=/opt/byzzcraft
ExecStart=/usr/bin/python3 /opt/byzzcraft/panel.py
Restart=on-failure
# the Minecraft server runs in its own session: it keeps running when the panel restarts
KillMode=process

[Install]
WantedBy=multi-user.target
